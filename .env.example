# Copy to .env and fill in. .env is gitignored.
# The adjudicator (Gemini) goes through OpenRouter.
OPENROUTER_API_KEY=
# The observer and the interlocutor call DeepSeek directly.
DEEPSEEK_API_KEY=
# live = call the providers; replay = read fixtures/cassettes. Tests always force replay.
PROBE_MODE=replay
PROBE_DB=probe.db
