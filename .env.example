# Copy to .env and fill in. .env is gitignored.
# The adjudicator (Gemini) goes through OpenRouter.
OPENROUTER_API_KEY=
# The observer and the interlocutor call DeepSeek directly.
DEEPSEEK_API_KEY=
# Optional: the comparison observer (scripts/compare_observers.py). The Authorization
# key from developers.sber.ru Studio; see docs/gigachat.md.
GIGACHAT_CREDENTIALS=
# Russian Trusted Root CA; this is the default path.
# GIGACHAT_CA_BUNDLE=~/.certs/russian_trusted_root_ca.pem
# live = call the providers; replay = read fixtures/cassettes. Tests always force replay.
PROBE_MODE=replay
PROBE_DB=probe.db
